<script setup>
import { ref, computed, onMounted, onUnmounted, nextTick } from 'vue'
import { ElMessage, ElMessageBox } from 'element-plus'
import {
  Search, Setting, Upload, Download, DocumentChecked,
  EditPen, InfoFilled, ArrowDown
} from '@element-plus/icons-vue'
import {
  getSeriesList, getModels, getConfigRows, updateConfigValue,
  batchUpdateConfigValues, createDraftBatch, getDraftStats, createDraft,
  submitDraftBatch, discardDraftBatch, deleteDraftByKey,
  importExcel, exportExcel, createVersion, getEnumValues
} from '../api/data'

// ==================== 基础数据 ====================
const seriesList = ref([])
const modelList = ref([])
const tableData = ref([])
const loading = ref(false)

// ==================== 筛选条件 ====================
const selectedSeries = ref(null)
const selectedModels = ref([])
const selectedCategories = ref([])
const tempCategories = ref([])
const searchText = ref('')
const tempSearchText = ref('')
const diffFilterMode = ref(false)

// ==================== 列配置 ====================
const popoverRef = ref(null)
const visibleColumns = ref({
  rd_name: true,
  v_code: true,
  ipn: true,
  zh_desc: false,
  en_desc: false,
  final_config: true,
  current_config: true,
  selection_config: true,
  rd_status: true
})
const fixedColumns = ref({
  rd_name: true,
  v_code: false,
  ipn: false,
  zh_desc: false,
  en_desc: false
})
const tempVisibleColumns = ref({})
const tempFixedColumns = ref({})

// ==================== 枚举值 ====================
const enumValues = ref({
  selectionTypes: [],
  rdStatuses: [],
  configValues: []
})

// ==================== 草稿管理 ====================
const draftBatchId = ref(null)
const draftStats = ref({ total: 0, create: 0, update: 0, delete: 0 })
const draftChanges = ref(new Map())
const draftFilter = ref('')

// ==================== 选择和编辑 ====================
const selectedRows = ref([])
const selectedCells = ref([])
const copiedCell = ref(null)
const copiedRowConfig = ref(null)
const tableRef = ref(null)

// ==================== 右键菜单 ====================
const contextMenuVisible = ref(false)
const contextMenuX = ref(0)
const contextMenuY = ref(0)
const contextMenuRow = ref(null)
const contextMenuColumn = ref(null)
const contextMenuCell = ref(null)

// ==================== 对话框 ====================
const batchEditVisible = ref(false)
const batchEditField = ref('')
const batchEditValue = ref('')
const submitDialogVisible = ref(false)
const submitForm = { version_number: '', description: '' }
const versionDialogVisible = ref(false)
const versionForm = { version_number: '', description: '' }
const importDialogVisible = ref(false)
const importProgress = ref(0)
const importStatus = ref('')
const importFileInfo = ref(null)

// ==================== 提示卡片 ====================
const showTips = ref(true)
const tipsExpanded = ref(false)

// ==================== 分页 ====================
const currentPage = ref(1)
const pageSize = ref(100)

// ==================== 过滤后的表格数据 ====================
const filteredTableData = computed(() => {
  let data = tableData.value

  // 分类筛选
  if (selectedCategories.value.length > 0) {
    data = data.filter(row => selectedCategories.value.includes(row.category))
  }

  // 搜索筛选
  if (searchText.value) {
    const search = searchText.value.toLowerCase()
    data = data.filter(row =>
      row.rd_name?.toLowerCase().includes(search) ||
      row.ipn?.toLowerCase().includes(search)
    )
  }

  // 差异筛选（当选择多个型号时）
  if (diffFilterMode.value && selectedModels.value.length >= 2) {
    data = data.filter(row => hasDiffInRow(row))
  }

  // 草稿类型筛选
  if (draftFilter.value) {
    data = data.filter(row => {
      for (const modelId of selectedModels.value) {
        const key = `${row.id}_${modelId}_${draftFilter.value}`
        if (draftChanges.value.has(key)) return true
      }
      return false
    })
  }

  // 分页
  const start = (currentPage.value - 1) * pageSize.value
  return data.slice(start, start + pageSize.value)
})

// ==================== 加载函数 ====================
const loadSeries = async () => {
  try {
    const res = await getSeriesList()
    seriesList.value = res.items || []
    if (seriesList.value.length > 0) {
      selectedSeries.value = seriesList.value[0].id
      await loadModels()
    }
  } catch (error) {
    console.error('加载产品系列失败:', error)
    ElMessage.error('加载产品系列失败')
  }
}

const loadModels = async () => {
  if (!selectedSeries.value) return
  try {
    const res = await getModels(selectedSeries.value)
    modelList.value = res.items || []
    if (modelList.value.length > 0) {
      selectedModels.value = [modelList.value[0].id]
      await loadTableData()
    }
  } catch (error) {
    console.error('加载产品型号失败:', error)
    ElMessage.error('加载产品型号失败')
  }
}

const loadTableData = async () => {
  if (!selectedSeries.value || selectedModels.value.length === 0) return

  loading.value = true
  try {
    const res = await getConfigRows({
      series_id: selectedSeries.value,
      model_ids: selectedModels.value.join(',')
    })
    tableData.value = res.items || []
    currentPage.value = 1

    // 初始化草稿批次
    await initDraftBatch()

    // 加载枚举值
    await loadEnumValues()
  } catch (error) {
    console.error('加载配置数据失败:', error)
    ElMessage.error('加载配置数据失败')
  } finally {
    loading.value = false
  }
}

const loadEnumValues = async () => {
  try {
    const res = await getEnumValues()
    enumValues.value.selectionTypes = (res.selection_types || []).filter(v => v !== '已完成')
    enumValues.value.rdStatuses = (res.rd_statuses || []).filter(v =>
      ['未定义', '未完成', '招标完成', '已完成'].includes(v)
    )
    const allValues = [...new Set([...res.selection_types || [], ...res.rd_statuses || []])]
    enumValues.value.configValues = allValues.filter(v => v !== '已完成')
  } catch (error) {
    console.error('加载枚举值失败:', error)
  }
}

const initDraftBatch = async () => {
  if (!selectedSeries.value) return
  try {
    // 检查是否有现有草稿批次
    const existingBatch = await getCurrentDraftBatch(selectedSeries.value)
    if (existingBatch && existingBatch.id) {
      draftBatchId.value = existingBatch.id
      await loadDraftStats()
    } else {
      // 创建新批次
      const batchRes = await createDraftBatch(selectedSeries.value)
      draftBatchId.value = batchRes.id
    }
  } catch (error) {
    // 如果获取失败，创建新批次
    try {
      const batchRes = await createDraftBatch(selectedSeries.value)
      draftBatchId.value = batchRes.id
    } catch (e) {
      console.error('初始化草稿批次失败:', e)
    }
  }
}

const loadDraftStats = async () => {
  if (!draftBatchId.value) return
  try {
    const res = await getDraftStats(draftBatchId.value)
    draftStats.value = res
  } catch (error) {
    console.error('加载草稿统计失败:', error)
  }
}

// ==================== 事件处理 ====================
const handleSeriesChange = async () => {
  selectedModels.value = []
  tableData.value = []
  draftStats.value = { total: 0, create: 0, update: 0, delete: 0 }
  draftChanges.value.clear()
  await loadModels()
}

const applyFilters = () => {
  selectedCategories.value = [...tempCategories.value]
  searchText.value = tempSearchText.value
  currentPage.value = 1
}

const toggleDiffFilter = () => {
  diffFilterMode.value = !diffFilterMode.value
  currentPage.value = 1
}

const toggleDraftFilter = (type) => {
  draftFilter.value = draftFilter.value === type ? '' : type
  currentPage.value = 1
}

// ==================== 列筛选 ====================
const initTempColumns = () => {
  tempVisibleColumns.value = { ...visibleColumns.value }
  tempFixedColumns.value = { ...fixedColumns.value }
}

const applyTempColumns = () => {
  // 确保至少有一列固定
  const hasFixed = Object.entries(tempFixedColumns.value)
    .some(([key, val]) => tempVisibleColumns.value[key] && val)
  if (!hasFixed) {
    tempFixedColumns.value.rd_name = true
  }
  visibleColumns.value = { ...tempVisibleColumns.value }
  fixedColumns.value = { ...tempFixedColumns.value }
}

const applyTempColumnsAndClose = () => {
  applyTempColumns()
  popoverRef.value?.hide()
}

const resetTempColumns = () => {
  tempVisibleColumns.value = {
    rd_name: true, v_code: true, ipn: true, zh_desc: false, en_desc: false,
    final_config: true, current_config: true, selection_config: true, rd_status: true
  }
  tempFixedColumns.value = { rd_name: true, v_code: false, ipn: false, zh_desc: false, en_desc: false }
}

// ==================== 配置修改 ====================
const handleConfigChange = async (row, modelId, fieldName) => {
  if (!draftBatchId.value) return

  const newValue = row.config_values[modelId][fieldName]
  const key = `${row.id}_${modelId}_${fieldName}`

  try {
    const res = await createDraft({
      series_id: selectedSeries.value,
      batch_id: draftBatchId.value,
      change_type: 'update',
      item_id: row.id,
      model_id: parseInt(modelId),
      field_name: fieldName,
      new_value: newValue,
      old_value: null
    })
    draftChanges.value.set(key, { newValue, draftId: res.draft_id })
    await loadDraftStats()
  } catch (error) {
    console.error('保存草稿失败:', error)
    ElMessage.error('保存失败')
  }
}

// ==================== 选择处理 ====================
const handleSelectionChange = (rows) => {
  selectedRows.value = rows
}

const handleCellClick = (row, column, cell) => {
  // Ctrl+点击添加到单元格选择
  if (window.event?.ctrlKey) {
    const cellKey = `${row.id}_${column.property}`
    const index = selectedCells.value.findIndex(c => c.key === cellKey)
    if (index > -1) {
      selectedCells.value.splice(index, 1)
    } else {
      selectedCells.value.push({ key: cellKey, row, column })
    }
  }
}

const handleCellDblClick = (row, column) => {
  // 双击进入编辑模式
}

const handleRowContextMenu = (row, column, event) => {
  event.preventDefault()
  contextMenuVisible.value = true
  contextMenuX.value = event.clientX
  contextMenuY.value = event.clientY
  contextMenuRow.value = row
  contextMenuColumn.value = column
}

// ==================== 右键菜单操作 ====================
const copyCell = () => {
  if (contextMenuRow.value && contextMenuColumn.value) {
    const modelId = selectedModels.value[0]
    const fieldName = contextMenuColumn.property
    copiedCell.value = {
      value: contextMenuRow.value.config_values?.[modelId]?.[fieldName],
      fieldName
    }
    ElMessage.success('已复制')
  }
  hideContextMenu()
}

const pasteCell = async () => {
  if (!copiedCell.value || selectedCells.value.length === 0) return
  // 实现粘贴逻辑
  hideContextMenu()
}

const applyToAllModels = async () => {
  if (!contextMenuRow.value || selectedModels.value.length < 2) return
  // 实现应用到所有机型
  hideContextMenu()
  ElMessage.success('已应用到所有机型')
}

const copyRowConfig = () => {
  if (contextMenuRow.value) {
    copiedRowConfig.value = contextMenuRow.value.config_values
    ElMessage.success('已复制整行配置')
  }
  hideContextMenu()
}

const pasteRowConfig = async () => {
  if (!copiedRowConfig.value) return
  // 实现粘贴行配置
  hideContextMenu()
}

const clearCell = async () => {
  // 清空单元格
  hideContextMenu()
}

const hideContextMenu = () => {
  contextMenuVisible.value = false
}

// ==================== 批量操作 ====================
const handleBatchEdit = () => {
  batchEditField.value = ''
  batchEditValue.value = ''
  batchEditVisible.value = true
}

const getBatchEditOptions = () => {
  if (batchEditField.value === 'selection_config') return enumValues.value.selectionTypes
  if (batchEditField.value === 'rd_status') return enumValues.value.rdStatuses
  return enumValues.value.configValues
}

const confirmBatchEdit = async () => {
  if (!batchEditField.value || selectedRows.value.length === 0) return

  try {
    const updates = []
    for (const row of selectedRows.value) {
      for (const modelId of selectedModels.value) {
        updates.push({
          item_id: row.id,
          model_id: parseInt(modelId),
          field_name: batchEditField.value,
          new_value: batchEditValue.value
        })
      }
    }

    await batchUpdateConfigValues({ updates })
    ElMessage.success(`已修改 ${updates.length} 项`)
    batchEditVisible.value = false
    await loadTableData()
  } catch (error) {
    console.error('批量修改失败:', error)
    ElMessage.error('批量修改失败')
  }
}

const pasteToSelectedCells = async () => {
  if (!copiedCell.value || selectedCells.value.length === 0) return
  // 实现粘贴到选中单元格
  ElMessage.success('已粘贴')
}

const clearSelection = () => {
  selectedRows.value = []
  selectedCells.value = []
}

// ==================== 草稿提交/废弃 ====================
const handleSubmitDraft = () => {
  submitForm.version_number = ''
  submitForm.description = ''
  submitDialogVisible.value = true
}

const confirmSubmitDraft = async () => {
  if (!draftBatchId.value) return

  try {
    await submitDraftBatch(draftBatchId.value, {
      version_number: submitForm.version_number || undefined,
      description: submitForm.description || undefined
    })

    ElMessage.success('提交成功')
    submitDialogVisible.value = false
    draftStats.value = { total: 0, create: 0, update: 0, delete: 0 }
    draftChanges.value.clear()
    await loadTableData()
  } catch (error) {
    console.error('提交失败:', error)
    ElMessage.error('提交失败')
  }
}

const handleDiscardDraft = async () => {
  if (!draftBatchId.value) return

  try {
    await ElMessageBox.confirm('确认废弃所有草稿？此操作不可恢复。', '确认', {
      confirmButtonText: '确定',
      cancelButtonText: '取消',
      type: 'warning'
    })

    await discardDraftBatch(draftBatchId.value)
    ElMessage.success('已废弃')
    draftStats.value = { total: 0, create: 0, update: 0, delete: 0 }
    draftChanges.value.clear()
    await loadTableData()
  } catch (error) {
    if (error !== 'cancel') {
      console.error('废弃失败:', error)
      ElMessage.error('废弃失败')
    }
  }
}

// ==================== 导入导出 ====================
const handleMultiFileUpload = async (options) => {
  const { file } = options
  importDialogVisible.value = true
  importProgress.value = 0
  importStatus.value = ''
  importFileInfo.value = { name: file.name, processed: 0, total: 0 }

  try {
    const formData = new FormData()
    formData.append('file', file)

    const res = await importExcel(formData, { series_id: selectedSeries.value })
    importProgress.value = 100
    importStatus.value = 'success'
    importFileInfo.value.processed = res.processed || 0
    importFileInfo.value.total = res.total || 0

    ElMessage.success(`导入成功，共处理 ${res.processed || 0} 条记录`)
    await loadTableData()
  } catch (error) {
    console.error('导入失败:', error)
    importProgress.value = 100
    importStatus.value = 'exception'
    ElMessage.error('导入失败')
  }
}

const handleExport = async () => {
  if (!selectedSeries.value) return

  try {
    const response = await exportExcel(selectedSeries.value, {
      model_ids: selectedModels.value.join(',')
    })

    const blob = new Blob([response], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' })
    const url = window.URL.createObjectURL(blob)
    const link = document.createElement('a')
    link.href = url
    link.setAttribute('download', `配置导出_${Date.now()}.xlsx`)
    document.body.appendChild(link)
    link.click()
    document.body.removeChild(link)
    window.URL.revokeObjectURL(url)

    ElMessage.success('导出成功')
  } catch (error) {
    console.error('导出失败:', error)
    ElMessage.error('导出失败')
  }
}

// ==================== 版本管理 ====================
const handleCreateVersion = () => {
  versionForm.version_number = ''
  versionForm.description = ''
  versionDialogVisible.value = true
}

const confirmCreateVersion = async () => {
  if (!selectedSeries.value) return

  try {
    await createVersion({
      series_id: selectedSeries.value,
      version_number: versionForm.version_number || undefined,
      description: versionForm.description || undefined
    })

    ElMessage.success('版本创建成功')
    versionDialogVisible.value = false
  } catch (error) {
    console.error('创建版本失败:', error)
    ElMessage.error('创建版本失败')
  }
}

// ==================== 辅助函数 ====================
const getModelName = (modelId) => {
  const model = modelList.value.find(m => m.id === modelId)
  return model ? model.name : `型号${modelId}`
}

const hasDiffInRow = (row) => {
  if (!row.config_values || selectedModels.value.length < 2) return false

  const values = []
  for (const modelId of selectedModels.value) {
    const config = row.config_values[modelId]
    if (config) {
      for (const field of ['final_config', 'current_config', 'selection_config', 'rd_status']) {
        if (visibleColumns.value[field]) {
          values.push(config[field])
        }
      }
    }
  }

  const filteredValues = values.filter(v => v !== null && v !== undefined && v !== '' && v !== 'N/A')
  if (filteredValues.length === 0) return false
  return new Set(filteredValues).size > 1
}

const toggleTipsExpand = () => {
  tipsExpanded.value = !tipsExpanded.value
}

// ==================== 全局事件 ====================
const handleClickOutside = (event) => {
  if (!event.target.closest('.context-menu')) {
    hideContextMenu()
  }
}

// ==================== 生命周期 ====================
onMounted(() => {
  loadSeries()
  document.addEventListener('click', handleClickOutside)
})

onUnmounted(() => {
  document.removeEventListener('click', handleClickOutside)
})
</script>

